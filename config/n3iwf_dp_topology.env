# L25GC-plus same-server N3IWF/ONVM deployment contract for the three-NIC host.
#
# This file contains non-secret machine and topology constants shared by the
# launch scripts. Edit them to match the deployment hardware.

# ONVM identities. Valid service IDs are 1..31 in this ONVM tree.
N3IWF_DP_SERVICE_ID=14
N3IWF_DP_INSTANCE_ID=14
N3IWF_DP_CONTROL_SOCKET=/run/l25gc/n3iwf-dp.sock
UPF_U_SERVICE_ID=1
UPF_C_SERVICE_ID=2

# Dedicated lcores in the default deployment.
UPF_U_CORE_ID=3
UPF_C_CORE_ID=4
N3IWF_DP_CORE_ID=14

# mlx5 ports enumerate by PCI address on this host: 08:00.0 is port 0 and
# 09:00.0 is port 1. mlx5 uses bifurcated kernel/DPDK ownership.
ONVM_PORTMASK=3
ONVM_ACCESS_PORT=1
ONVM_ACCESS_PCI=0000:09:00.0
ONVM_ACCESS_INTERFACE=enp9s0
ONVM_N6_PORT=0
ONVM_N6_PCI=0000:08:00.0
ONVM_N6_INTERFACE=enp8s0

# Logical IPv4 N3 contract carried inside ONVM mbufs. N3 is not a physical
# port in the same-server N3IWF deployment.
N3IWF_N3_IPV4=192.168.4.1
UPF_N3_IPV4=192.168.4.2

# Physical N6 subnet on DPDK port 0. Configure the directly attached DN NIC
# as 192.168.3.2/24 and route the UE pools back through 192.168.3.1.
UPF_N6_IPV4=192.168.3.1
DN_N6_IPV4=192.168.3.2
N6_PREFIX_LENGTH=24

# Kernel-owned interfaces are documented here but never passed to DPDK.
N3IWF_N2_INTERFACE=enp7s0
N3IWF_N2_IPV4=192.168.1.2
MANAGEMENT_INTERFACE=enp3s0
MANAGEMENT_IPV4=10.20.5.38

# Local non3gpp_test NWu address. A physical UE deployment may override this
# address without changing the DPDK port role.
N3IWF_TEST_NWU_IPV4=192.168.2.2
N3IWF_TEST_UE_NWU_IPV4=192.168.2.1
NWU_PREFIX_LENGTH=24
N3IWF_CP_TAP_INTERFACE=n3iwf-cp
N3IWF_DP_KERNEL_SIGNALLING_ESP=1

# Fixed IP-MTU profile enforced by N3IWF-DP. These values exclude Ethernet.
# A different NWu MTU/security profile requires updating n3iwf_dp_mtu.h and
# rerunning the boundary component and live acceptance tests.
NWU_IP_MTU=1500
LOGICAL_N3_IP_MTU=1500
N6_IP_MTU=1500
N3IWF_MAX_INNER_IP_PACKET=1410

# GRE endpoints inside IPsec for the deterministic local test. These are
# distinct from the IKE/ESP outer addresses above.
N3IWF_IPSEC_INNER_IPV4=10.0.0.1
N3IWF_TEST_UE_IPSEC_INNER_IPV4=10.0.0.2
UE_PDU_IPV4_CIDR=10.60.0.0/16
