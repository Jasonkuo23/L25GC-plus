# L25GC-plus same-server N3IWF/ONVM runtime settings.
#
# This file contains non-secret machine and topology constants shared by the
# launch scripts. Edit them to match the deployment hardware.

# ONVM identities. Valid service IDs are 1..31 in this ONVM tree.
N3IWF_DP_SERVICE_ID=14
N3IWF_DP_INSTANCE_ID=14
N3IWF_DP_CONTROL_SOCKET=/run/l25gc/n3iwf-dp.sock
UPF_U_SERVICE_ID=1
UPF_C_SERVICE_ID=2

# Dedicated lcores in the default deployment.
UPF_U_CORE_ID=3
UPF_C_CORE_ID=4
N3IWF_DP_CORE_ID=5

# DPDK enumerates these PCI devices by PCI address on this host, independent
# of their order in the allow list. The mapping was verified from manager MAC
# addresses: port 0=02:00.3 and port 1=82:00.0.
ONVM_PORTMASK=3
ONVM_ACCESS_PORT=1
ONVM_ACCESS_PCI=0000:82:00.0
ONVM_N6_PORT=0
ONVM_N6_PCI=0000:02:00.3

# Logical IPv4 N3 contract carried inside ONVM mbufs. N3 is not a physical
# port in the same-server N3IWF deployment.
N3IWF_N3_IPV4=192.168.2.1
UPF_N3_IPV4=192.168.2.2

# Physical N6 subnet on DPDK port 0. Configure the directly attached DN NIC
# as 192.168.3.2/24 and route the UE pools back through 192.168.3.1.
UPF_N6_IPV4=192.168.3.1
DN_N6_IPV4=192.168.3.2
N6_PREFIX_LENGTH=24

# Same-host control-plane endpoints. N2, N4 and SBI use loopback and never
# enter either DPDK port.
AMF_N2_IPV4=127.0.0.18
SMF_N4_IPV4=127.0.0.1
UPF_C_N4_IPV4=127.0.0.8

# Kernel-owned management interface. This is not passed to DPDK.
MANAGEMENT_INTERFACE=eno1
MANAGEMENT_IPV4=130.127.133.102

# NWu outer endpoints on DPDK access port 1. The N3IWF address is also the
# address that the future low-rate CP punt/TAP interface must present to the
# Go IKE server; it must not be assigned to a physical kernel NIC.
N3IWF_TEST_NWU_IPV4=192.168.127.1
N3IWF_TEST_UE_NWU_IPV4=192.168.127.2
NWU_PREFIX_LENGTH=24
N3IWF_CP_TAP_INTERFACE=n3iwf-cp

# Temporary migration switch: allow signalling Child-SA ESP to use free5GC's
# kernel XFRM path through the TAP. User-plane Child SAs remain fail-closed in
# N3IWF-DP until the DPDK cryptodev backend is implemented. Set to 0 once all
# Child SAs are owned by N3IWF-DP.
N3IWF_DP_KERNEL_SIGNALLING_ESP=1

# GRE endpoints inside IPsec for the deterministic local test. These are
# distinct from the IKE/ESP outer addresses above.
N3IWF_IPSEC_INNER_IPV4=10.0.0.1
N3IWF_TEST_UE_IPSEC_INNER_IPV4=10.0.0.2

# First accepted IPv4/single-QFI PDU-session slice.
UE_PDU_IPV4_CIDR=10.60.0.0/16
