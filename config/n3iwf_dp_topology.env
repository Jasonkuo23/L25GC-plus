# L25GC-plus same-server N3IWF/ONVM deployment contract.
#
# This file contains non-secret, machine/topology constants shared by the
# launch and validation scripts. Edit this contract and rerun
# scripts/check_n3iwf_topology.sh when deploying a different topology.

# ONVM identities. Valid service IDs are 1..31 in this ONVM tree.
N3IWF_DP_SERVICE_ID=14
N3IWF_DP_INSTANCE_ID=14
UPF_U_SERVICE_ID=1
UPF_C_SERVICE_ID=2

# Dedicated lcores in the default deployment.
UPF_U_CORE_ID=3
UPF_C_CORE_ID=4
N3IWF_DP_CORE_ID=5

# Physical DPDK port order is determined by the manager allow list.
ONVM_PORTMASK=3
ONVM_ACCESS_PORT=0
ONVM_ACCESS_PCI=0000:08:00.0
ONVM_N6_PORT=1
ONVM_N6_PCI=0000:09:00.0

# Logical IPv4 N3 contract carried inside ONVM mbufs. N3 is not a physical
# port in the same-server N3IWF deployment.
N3IWF_N3_IPV4=192.168.2.1
UPF_N3_IPV4=192.168.2.2

# Physical N6 address configured by ONVM-UPF.
UPF_N6_IPV4=192.168.3.1

# Kernel-owned interfaces are documented here but never passed to DPDK.
N3IWF_N2_INTERFACE=enp7s0
N3IWF_N2_IPV4=192.168.1.2
MANAGEMENT_INTERFACE=enp3s0

# Local non3gpp_test NWu address. A physical UE deployment may override this
# address without changing the DPDK port role.
N3IWF_TEST_NWU_IPV4=192.168.127.1

# GRE endpoints inside IPsec for the deterministic local test. These are
# distinct from the IKE/ESP outer addresses above.
N3IWF_IPSEC_INNER_IPV4=10.0.0.1
N3IWF_TEST_UE_IPSEC_INNER_IPV4=10.0.0.2
